{
  "$schema": "https://schema.tauri.dev/config/2",
  "productName": "Slack Approval Gateway",
  "version": "0.1.0",
  "identifier": "ai.mistral.slack-approval-gateway",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Slack Approval Gateway",
        "width": 720,
        "height": 780,
        "minWidth": 520,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
